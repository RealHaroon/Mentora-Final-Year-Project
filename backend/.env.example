# Copy this file to .env and fill in real values for your machine.

# SQLite needs nothing further. To use Postgres instead:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/mentora_db
DATABASE_URL=sqlite:///./mentora.db

# Generate a real secret before anything but local dev: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]
