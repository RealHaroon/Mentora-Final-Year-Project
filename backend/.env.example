# Copy this file to .env and fill in real values for your machine.

# SQLite needs nothing further. To use Postgres instead:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/mentora_db
DATABASE_URL=sqlite:///./mentora.db

# Generate a real secret before anything but local dev: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]

# Phase 6 — Model Manager. Set true to mount /debug/model-status.
DEBUG=false

# Paths are relative to backend/'s own cwd (where uvicorn is started from).
# ml_models/saved/ is a sibling of backend/ — see Phase 5's packaging step.
MODEL1_PATH=../ml_models/saved/model1_gap_classifier
MODEL2_PATH=../ml_models/saved/model2_question_generator
MODEL3_PATH=../ml_models/saved/model3_trajectory_predictor/lstm_final.pt
MODEL4_PATH=../ml_models/saved/model4_career_matcher
MODEL5_PATH=../ml_models/saved/model5_cv_ner
TOPICS_JSON=./data/topics.json
M5_ID2TAG_JSON=./data/m5_id2tag.json
